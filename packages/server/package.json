    "simple-icons": "^16.27.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260726.1",
    "@types/react": "^19.2.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "react": "^19.2.0",
    "typescript": "^5",
    "vitest": "^4.1.1",
    "wrangler": "^4.114.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  }
