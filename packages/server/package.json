{
  "name": "@guessx/server",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./react": "./src/room-connection.tsx"
  },
  "scripts": {
    "fmt": "oxfmt --write src tests vitest.config.mts tsconfig.json package.json wrangler.test.jsonc",
